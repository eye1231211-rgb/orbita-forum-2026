# Optional: defaults are sufficient for the fictional demo.
# Do not put real student data or university credentials here.
# Все значения ниже — placeholder: настоящие ключи выдаёт ИТ-служба РЭУ.
# Полное описание подключения: docs/ПОДКЛЮЧЕНИЕ-РЭУ.md
WRANGLER_SEND_METRICS=false
CLOUDFLARE_CF_FETCH_ENABLED=false

# Node-only portable runtime. Set these in the environment of the process.
# Optional locally; set an exact HTTPS PUBLIC_ORIGIN behind a TLS proxy.
# HOST=127.0.0.1
# PORT=3000
# DB_PATH=data/orbita.sqlite
# PUBLIC_ORIGIN=https://your-domain.example

# ------------------------------------------------------------------
# Расписание: всегда живое, берётся с публичного экспорта rasp.rea.ru.
# Настроек не требует.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Вход: demo (по умолчанию) или oidc — единый вход университета.
# ------------------------------------------------------------------
ORBIT_IDENTITY=demo
# OIDC_ISSUER=https://sso.example.rea.ru/realms/students
# OIDC_CLIENT_ID=orbita-portal
# OIDC_CLIENT_SECRET=changeme-выдаёт-ит-служба-РЭУ
# OIDC_SCOPES=openid profile
# Подписывает короткоживущую cookie перелёта входа, не короче 32 символов.
# Свой ключ: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
# ORBIT_AUTH_SECRET=changeme-не-короче-32-символов
# Имена утверждений (claims), если в РЭУ они называются иначе.
# OIDC_LOGIN_CLAIM=preferred_username
# OIDC_GROUP_CLAIM=group
# OIDC_INSTITUTE_CLAIM=institute
# OIDC_PROGRAM_CLAIM=program
# OIDC_COURSE_CLAIM=course
# OIDC_SEMESTER_CLAIM=semester

# ------------------------------------------------------------------
# Баллы: demo (по умолчанию) или university — ведомость РЭУ.
# ------------------------------------------------------------------
ORBIT_GRADES=demo
# UNIVERSITY_GRADES_URL=https://api.example.rea.ru/orbita/grades
# UNIVERSITY_GRADES_TOKEN=changeme-служебный-доступ
